# Игнорируем папки локальной сборки .NET (ОБЯЗАТЕЛЬНО)
bin/
obj/

# Игнорируем настройки локального запуска и секреты
Properties/launchSettings.json
appsettings.Development.json
*.user

# Игнорируем папки логирования и временные файлы, если они создаются внутри API
logs/
*.log

# Игнорируем скрытые папки систем контроля версий и редакторов (на случай, если попадут)
.git/
.vs/
.vscode/
.cursor/
